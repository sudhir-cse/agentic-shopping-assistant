{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Action": [
                "ecs:RegisterTaskDefinition",
                "ecs:DescribeTaskDefinition",
                "ecs:DeregisterTaskDefinition",
                "ecs:TagResource",
                "ecs:UntagResource",
                "ecs:ListTagsForResource"
            ],
            "Resource": "*"
        },
        {
            "Effect": "Allow",
            "Action": "iam:PassRole",
            "Resource": [
                "arn:aws:iam::<AWS_ACCOUNT_ID>:role/amazon-be-task-role",
                "arn:aws:iam::<AWS_ACCOUNT_ID>:role/amazon-fe-task-role",
                "arn:aws:iam::<AWS_ACCOUNT_ID>:role/ecsTaskExecutionRole"
            ]
        }
    ]
}